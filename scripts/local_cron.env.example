# 本機排程機密設定範本。
# 複製成同目錄的 local_cron.env 後填入實際值（local_cron.env 已被 .gitignore 忽略，切勿提交）。
#
#   cp scripts/local_cron.env.example scripts/local_cron.env
#
# Telegram 通知（缺少時 notify 會安全略過）
export TG_BOT_TOKEN="你的 Telegram bot token"
export TG_CHAT_ID="你的 Telegram chat id"

# Firestore 同步（缺少時 firebase_sync 會安全略過）
export FIREBASE_PROJECT_ID="你的 Firebase project id"
# 指向本機專用 service account JSON 的絕對路徑（勿放在 repo 內）
export GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/to/service-account.json"
