rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }

    match /admins/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    match /products/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /events/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // 儀表板可改的只有展示名稱（displayName）；label 等欄位仍只能由 Admin SDK 寫入。
    function isDisplayNameEdit() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
        && (
          !('displayName' in request.resource.data)
          || (
            request.resource.data.displayName is string
            && request.resource.data.displayName.size() > 0
            && request.resource.data.displayName.size() <= 60
          )
        );
    }

    match /sources/{sourceId} {
      allow read: if isAdmin();
      allow update: if isAdmin() && isDisplayNameEdit();
      allow create, delete: if false;
    }

    match /runs/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /meta/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
